<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- langues de l'application : macOS choisit selon la langue du système -->
	<key>CFBundleLocalizations</key>
	<array>
		<string>en</string>
		<string>fr</string>
	</array>
	<!-- affiché par macOS quand Lumen demande l'accès à iCloud Drive (ou à Dropbox, Google Drive…) pour la sauvegarde ;
	     traduit dans locales/*.lproj/InfoPlist.strings, ce texte-ci sert pour les autres langues du système -->
	<key>NSFileProviderDomainUsageDescription</key>
	<string>Lumen backs up your progress (words, lessons, settings) to your iCloud Drive or the folder you chose, so that it's never lost.</string>
</dict>
</plist>
